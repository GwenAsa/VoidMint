{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    "logo": {
        "type": "auto",
        "padding": {
            "right": 2
        },
        "color": {
            "1": "#478061",
            "2": "#ABC2AB"
        }
    },

    "display": {
        "separator": "  : ",
        "color": {
            "title": "#E3EAE4",
            "keys": "#ABC2AB",
            "output": "#DCE7DE",
            "separator": "#478061"
        },
        "key": {
            "width": 10
        }
    },

    "modules": [
        "title",
        "separator",
        "os",
        "kernel",
        "uptime",
        "packages",
        "shell",
        "terminal",
        "cpu",
        "memory"
    ]
}
